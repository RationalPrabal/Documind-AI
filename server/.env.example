# Copy to server/.env and fill in. Never commit .env.
# Only the first block is required; everything else has a sensible default.

# ---- Required ---------------------------------------------------------------
# Atlas → your cluster → Connect → Drivers. Include the user/password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# https://platform.openai.com/api-keys — stays on the server only.
OPENAI_API_KEY=sk-...
# Random string, >= 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----------------------------------------------------------------
MONGODB_DB=documind
VECTOR_INDEX_NAME=chunk_vector_index

# ---- OpenAI -----------------------------------------------------------------
CHAT_MODEL=gpt-5.4-mini
# Optional: none | minimal | low | medium | high. Reasoning tokens count toward
# MAX_OUTPUT_TOKENS, so keep this low (or empty) for a RAG answerer.
REASONING_EFFORT=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector index. Changing it requires re-running
# `npm run setup:indexes` and re-ingesting documents.
EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# ---- Ingestion --------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300
# Characters, not tokens. 1000 chars ≈ 250 English tokens.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retrieval & generation (cost controls) --------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_NUM_CANDIDATES=100
# Atlas cosine score is normalized to 0..1. Chunks below this are discarded,
# and if none remain the LLM is not called at all. Calibrated in Phase 3:
# answerable questions scored 0.57-0.80, clearly off-topic ones 0.52-0.56.
# This is a cost filter for off-topic questions; the LLM decides "not found".
RETRIEVAL_MIN_SCORE=0.55
MAX_CONTEXT_CHARS=12000
MAX_OUTPUT_TOKENS=800
MAX_QUESTION_CHARS=1000
# Conversation memory. The browser keeps the chat and sends the most recent
# messages with each question; the server uses them for that request only
# and never stores them. Every message costs input tokens on every turn.
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=6000

# ---- Abuse & cost protection ----------------------------------------------
# Number of reverse proxies in front of the app (0 locally). Behind Render or
# nginx, set it so the request log's "ip" shows YOUR public IP; that makes
# rate limits apply per visitor instead of per proxy.
TRUST_PROXY=0
# Optional: a code visitors must enter before uploading or asking. Leave empty
# locally; ALWAYS set it on a public deployment, or anyone can spend your
# OpenAI credit (up to the daily budgets below).
ACCESS_CODE=
# Per client IP.
UPLOADS_PER_HOUR=20
QUESTIONS_PER_10_MIN=60
# Global kill-switch per UTC day, so a bug or abuse can't run up a bill.
DAILY_CHAT_TOKEN_BUDGET=500000
DAILY_EMBEDDING_TOKEN_BUDGET=5000000
